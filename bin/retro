#!/usr/bin/env bash
set -euo pipefail

# Telemetry Instrumentation
python3 -m kernel.daemon_telemetry log SYSTEM START --domain bin --component $(basename "$0")
trap 'EXIT_CODE=$?; python3 -m kernel.daemon_telemetry log SYSTEM FINISH --domain bin --component '$(basename "$0")' --metadata "{\"exit_code\": $EXIT_CODE}"' EXIT


# Resolve repository root
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve python executable to use
if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python3" ]]; then
    PYTHON_EXE="$VIRTUAL_ENV/bin/python3"
elif [[ -x "/home/pt/actions-runner/venv/bin/python3" ]]; then
    PYTHON_EXE="/home/pt/actions-runner/venv/bin/python3"
else
    PYTHON_EXE="python3"
fi

PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -m kernel.daemon_retro "$@"
