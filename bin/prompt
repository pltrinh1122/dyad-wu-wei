#!/usr/bin/env bash
set -euo pipefail

# Telemetry Instrumentation
python3 -m kernel.daemon_telemetry log SYSTEM START --domain bin --component $(basename "$0")
trap 'EXIT_CODE=$?; python3 -m kernel.daemon_telemetry log SYSTEM FINISH --domain bin --component '$(basename "$0")' --metadata "{\"exit_code\": $EXIT_CODE}"' EXIT

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $0 queue <msg> | process | list"
    exit 0
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 queue <msg> | process"
    exit 1
fi

CMD=$1
if [[ "$CMD" == "queue" ]]; then
    shift
    MSG="$*"
    gh issue create --title "Prompt: $MSG" --body "" --label "staging"
elif [[ "$CMD" == "process" || "$CMD" == "list" ]]; then
    gh issue list --label "staging"
else
    # Legacy fallback: queue
    MSG="$*"
    gh issue create --title "Prompt: $MSG" --body "" --label "staging"
fi
