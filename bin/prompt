#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <prompt_text>"
    exit 1
fi

PROMPT_TEXT="$*"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKLOG_FILE="${REPO_DIR}/artifacts/prompt_backlog.yaml"

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

mkdir -p "$(dirname "$BACKLOG_FILE")"

# Output structured YAML block
cat <<YAML >> "$BACKLOG_FILE"
- timestamp: "$TIMESTAMP"
  type: "operator_prompt"
  text: |
    $PROMPT_TEXT

YAML

echo "Prompt queued to $BACKLOG_FILE"
