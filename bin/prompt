#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_EXE="${REPO_DIR}/venv/bin/python3"
if [ ! -f "$PYTHON_EXE" ]; then
    PYTHON_EXE="python3"
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $0 <prompt_text> | list | add | delete <prompt_id>"
    exit 0
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 <prompt_text> | list"
    exit 1
fi

CMD=$1
if [[ "$CMD" == "list" || "$CMD" == "add" || "$CMD" == "delete" ]]; then
    PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -m orchestrator.mgr_prompt "$@"
else
    # Legacy fallback: assume they just typed ./prompt "some text"
    PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -m orchestrator.mgr_prompt add "$*"
fi
