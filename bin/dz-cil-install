#!/usr/bin/env bash
# DZ-CIL Workspace Bootstrap Installer
# Auto-generated. Bootstraps a Model 1 child project workspace.
#
# Usage:
#   bin/dz-cil-install [DIR]
#   bin/dz-cil-install --help
#

set -euo pipefail

# ── Config & Helpers ──────────────────────────────────────────────────────────
_info()  { echo "  ℹ  $*"; }
_ok()    { echo "  ✅ $*"; }
_warn()  { echo "  ⚠️  $*"; }
_error() { echo "  ❌ $*" >&2; exit 1; }

_require() { command -v "$1" &>/dev/null || _error "'$1' is required but not found in PATH."; }

# Resolve CWD repository root
DZ_CIL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Show help
show_help() {
    cat << EOF
DZ-CIL Bootstrap Installer

Usage:
  bin/dz-cil-install [DIR]   Initialize workspace inside the specified directory
                             (default: ./.workspace/)
  bin/dz-cil-install --help  Print this help message
EOF
    exit 0
}

# Parse arguments
TARGET_DIR=""
if [ $# -gt 0 ]; then
    case "$1" in
        -h|--help)
            show_help
            ;;
        *)
            TARGET_DIR="$1"
            ;;
    esac
fi

if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR="$DZ_CIL_ROOT/.workspace"
else
    # Resolve absolute path of target directory
    if [[ "$TARGET_DIR" != /* ]]; then
        TARGET_DIR="$DZ_CIL_ROOT/$TARGET_DIR"
    fi
fi

_info "Bootstrapping DZ-CIL Model 1 Workspace..."
_info "Target Directory: $TARGET_DIR"
_info "DZ-CIL Root:      $DZ_CIL_ROOT"

# Verify system dependencies
_require "python3"
_require "git"

# 1. Directory Creation
_info "Creating target directories..."
mkdir -p "$TARGET_DIR/kb"
mkdir -p "$TARGET_DIR/artifacts"
_ok "Directories created."

# 2. Ignorance Configuration
_info "Configuring parent gitignore..."
GITIGNORE="$DZ_CIL_ROOT/.gitignore"
# Get relative path of target directory to DZ_CIL_ROOT
REL_DIR="${TARGET_DIR#$DZ_CIL_ROOT/}"
if [ "$REL_DIR" = "$TARGET_DIR" ]; then
    # Target directory is outside repo root, warning but no gitignore append
    _warn "Target directory is outside DZ-CIL Root. Skipping .gitignore entry."
else
    ENTRY="/$REL_DIR/"
    if [ -f "$GITIGNORE" ]; then
        if grep -qF "$ENTRY" "$GITIGNORE"; then
            _info "Gitignore entry already exists."
        else
            echo "$ENTRY" >> "$GITIGNORE"
            _ok "Appended $ENTRY to .gitignore"
        fi
    else
        echo "$ENTRY" > "$GITIGNORE"
        _ok "Created .gitignore and added $ENTRY"
    fi
fi

# 3. GEMINI Invariant Injection
_info "Injecting GEMINI.md bootloader..."
GEMINI_MD="$TARGET_DIR/GEMINI.md"

cat > "$GEMINI_MD" << 'EOF'
# GEMINI (Antigravity) Frontier Agent Instructions (Workspace Mode)

You are executing within a **Model 1 (Dual-Context Workspace)**. Your system parameters are bounded by the following rules:

## 1. Persona & Workspace Configuration
- **Role**: You are the **Frontier Agent** managing the workspace environment.
- **Active Workspace**: Operating under `SPAO_WORKSPACE_DIR`. All project metadata, tracking files, and knowledge primitives reside here.
- **Engine Isolation**: The parent engine repository (`DZ_CIL_ROOT`) is **read-only** and immutable during active workspace work. You are strictly forbidden from modifying or pushing changes to the parent engine files unless in direct engine development mode.

## 2. Redirection Invariants
- **Checkouts**: All node checkout operations must be redirected to `.worktrees/node/[id]-[kebab-case]/` inside this workspace directory.
- **Testing**: Test execution must verify target workspace branches inside their respective worktrees.

## 3. Operational Rules
- Follow the Sense-Plan-Act-Observe (SPAO) loop lifecycle.
- Maintain policy-driven communication via YAML/Markdown trackers inside this workspace's `artifacts/` folder.
EOF

_ok "GEMINI.md injected."

# 4. Virtual Environment Provisioning
_info "Provisioning virtual environment..."
VENV_DIR="$TARGET_DIR/.venv"

if [ -d "$VENV_DIR" ]; then
    _info "Virtual environment already exists."
else
    if python3 -m venv --help &>/dev/null; then
        python3 -m venv "$VENV_DIR"
    elif command -v virtualenv &>/dev/null; then
        virtualenv "$VENV_DIR"
    else
        _error "Neither python3-venv module nor virtualenv command is available."
    fi
    _ok "Virtual environment created at $VENV_DIR"
fi

# Resolve pip executable
PIP_EXE="$VENV_DIR/bin/pip"
if [ ! -x "$PIP_EXE" ]; then
    # Fallback/retry check
    PIP_EXE="$VENV_DIR/bin/pip3"
fi

_info "Installing dependencies..."
"$PIP_EXE" install --upgrade pip
"$PIP_EXE" install pytest pytest-mock pyyaml
_ok "Dependencies installed successfully."

_ok "DZ-CIL Workspace bootstrap completed successfully!"
echo ""
echo "Next Steps per Dao:"
echo "1. Initialize the child workspace:"
echo "   ./bin/workspace init <project_git_url>"
echo ""
echo "2. Start the agent:"
echo "   SPAO_WORKSPACE_DIR=\"$TARGET_DIR\" agy"
echo ""
