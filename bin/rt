#!/usr/bin/env bash
set -euo pipefail

# Telemetry Instrumentation
python3 -m kernel.daemon_telemetry log SYSTEM START --domain bin --component $(basename "$0")
trap 'EXIT_CODE=$?; python3 -m kernel.daemon_telemetry log SYSTEM FINISH --domain bin --component '$(basename "$0")' --metadata "{\"exit_code\": $EXIT_CODE}"' EXIT


REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_EXE="${REPO_DIR}/venv/bin/python3"
if [ ! -f "$PYTHON_EXE" ]; then
    PYTHON_EXE="python3"
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $0 {hotfix} [args...]"
    exit 0
fi

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 {hotfix} [args...]"
    exit 1
fi

PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -m kernel.daemon_rt "$@"
