#!/usr/bin/env bash
# SPAO Release Publisher
# Tags and publishes a new versioned release of the SPAO system.
# GitHub auto-generates the source tarball from the tag, which spao-install then fetches.
#
# Usage:
#   ./bin/spao-release <version> ["release notes"]
#   Example: ./bin/spao-release v0.2.0 "Add path_resolver and global CLI"
#
# Invariants honoured:
#   - Runs the full test suite before tagging (Testing Invariant)
#   - Uses skills/git_client.py for all git operations (Abstraction Doctrine Invariant)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPAO_CORE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

_ok()    { echo "  ✅ $*"; }
_info()  { echo "  ℹ  $*"; }
_error() { echo "  ❌ $*" >&2; exit 1; }

# ── Validate args ─────────────────────────────────────────────────────────────
if [ $# -lt 1 ]; then
    echo "Usage: spao-release <version> [\"release notes\"]"
    echo "  Example: ./bin/spao-release v0.2.0 \"Add global CLI deployment\""
    exit 1
fi

VERSION="$1"
NOTES="${2:-Release $VERSION}"

# Enforce semver format
if ! echo "$VERSION" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    _error "Version must follow semver format: vMAJOR.MINOR.PATCH (e.g. v0.2.0)"
fi

# Ensure we're on main and clean
CURRENT_BRANCH="$(git -C "$SPAO_CORE_DIR" rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" != "main" ]; then
    _error "Releases must be cut from 'main'. Currently on: $CURRENT_BRANCH"
fi

if ! git -C "$SPAO_CORE_DIR" diff --quiet || ! git -C "$SPAO_CORE_DIR" diff --cached --quiet; then
    _error "Working tree has uncommitted changes. Commit or stash before releasing."
fi

# Ensure tag doesn't already exist
if git -C "$SPAO_CORE_DIR" tag | grep -q "^${VERSION}$"; then
    _error "Tag $VERSION already exists. Choose a new version."
fi

echo "🚀 Preparing SPAO release $VERSION..."
echo "   Notes: $NOTES"
echo ""

# ── 1. Run full test suite ────────────────────────────────────────────────────
_info "Running test suite (Testing Invariant)..."
"$SPAO_CORE_DIR/bin/run-tests"
_ok "All tests passed"

# ── 2. Update VERSION file ────────────────────────────────────────────────────
echo "$VERSION" > "$SPAO_CORE_DIR/VERSION"
_ok "Updated VERSION → $VERSION"

# ── 3. Commit & push via git_client skill ────────────────────────────────────
_info "Committing release via git_client skill..."
python3 - "$SPAO_CORE_DIR" "$VERSION" << 'PY'
import sys
sys.path.insert(0, sys.argv[1])
from skills import git_client
git_client.add(["VERSION"])
git_client.commit(f"chore: release {sys.argv[2]}")
git_client.push("main")
PY
_ok "Committed and pushed"

# ── 4. Create and push annotated tag ─────────────────────────────────────────
_info "Creating annotated tag $VERSION via git_client skill..."
python3 - "$SPAO_CORE_DIR" "$VERSION" "$NOTES" << 'PY'
import sys
sys.path.insert(0, sys.argv[1])
from skills import git_client
git_client.tag(sys.argv[2], sys.argv[3])
git_client.tag_push(sys.argv[2])
PY
_ok "Tag $VERSION pushed"

# ── Done ──────────────────────────────────────────────────────────────────────
TARBALL_URL="https://github.com/pltrinh1122/agent-antigravity/archive/refs/tags/${VERSION}.tar.gz"
echo ""
echo "✅ SPAO $VERSION released successfully."
echo ""
echo "   Tarball (auto-generated by GitHub):"
echo "   $TARBALL_URL"
echo ""
echo "   Users can now install with:"
echo "   curl -sSL https://raw.githubusercontent.com/pltrinh1122/agent-antigravity/main/bin/spao-install | bash"
echo "   — or —"
echo "   spao-install --version $VERSION"
