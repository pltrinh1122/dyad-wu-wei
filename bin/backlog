#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $0 {list|new|view|edit} [args...]"
    exit 0
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 {list|new|view|edit} [args...]"
    exit 1
fi

SUBCOMMAND="$1"
shift

# Resolve repository root
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve python executable to use
if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python3" ]]; then
    PYTHON_EXE="$VIRTUAL_ENV/bin/python3"
elif [[ -x "/home/pt/actions-runner/venv/bin/python3" ]]; then
    PYTHON_EXE="/home/pt/actions-runner/venv/bin/python3"
else
    PYTHON_EXE="python3"
fi

case "$SUBCOMMAND" in
    list)
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c "
from skills.github_client import list_issues_by_label
items = list_issues_by_label('backlog')
if items:
    print('\n📋 Backlog ({} item(s) pending):'.format(len(items)))
    for item in items:
        print('  {}'.format(item['title']))
    print()
else:
    print('Backlog is empty.')
"
        ;;
    new)
        if [ "$#" -lt 3 ]; then
            echo "Usage: $0 new <probe|activity> <title> <goal>"
            exit 1
        fi
        
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c "
import sys
from skills.github_client import add_to_backlog
try:
    print(add_to_backlog(sys.argv[1], sys.argv[2], sys.argv[3]))
except Exception as e:
    print(str(e))
    sys.exit(1)
" "$1" "$2" "$3"
        ;;
    view)
        if [ "$#" -lt 1 ]; then
            echo "Usage: $0 view <issue_id>"
            exit 1
        fi
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c "
import subprocess, json, sys
res = subprocess.run(['gh', 'issue', 'view', sys.argv[1], '--json', 'title,state,body'], capture_output=True, text=True, check=True)
data = json.loads(res.stdout)
print('='*40)
print('Issue #{}: {} [{}]'.format(sys.argv[1], data['title'], data['state']))
print('='*40)
print(data['body'])
print('='*40)
" "$1"
        ;;
    edit)
        if [ "$#" -lt 2 ]; then
            echo "Usage: $0 edit <issue_id> <new_body>"
            exit 1
        fi
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c "import sys; from skills.github_client import update_issue_body; update_issue_body(sys.argv[1], sys.argv[2])" "$1" "$2"
        ;;
    *)
        echo "Unknown subcommand: $SUBCOMMAND"
        echo "Usage: $0 {list|new|view|edit} [args...]"
        exit 1
        ;;
esac
