#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $0 {link|check|active|path|audit|rehash|lint} [args...]"
    exit 0
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 {link|check|active|path|audit|rehash|lint} [args...]"
    exit 1
fi

SUBCOMMAND="$1"
shift

# Resolve repository root
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve python executable to use
if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python3" ]]; then
    PYTHON_EXE="$VIRTUAL_ENV/bin/python3"
elif [[ -x "/home/pt/actions-runner/venv/bin/python3" ]]; then
    PYTHON_EXE="/home/pt/actions-runner/venv/bin/python3"
else
    PYTHON_EXE="python3"
fi

case "$SUBCOMMAND" in
    link)
        if [ "$#" -lt 2 ]; then
            echo "Usage: $0 link <node_title> <issue_id> [path_issue_id]"
            exit 1
        fi
        PATH_ISSUE="${3:-10}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
import subprocess
import json
from drivers.github_client import update_issue_body

node_title = sys.argv[1]
issue_id = sys.argv[2]
path_issue = sys.argv[3]

res = subprocess.run(["gh", "issue", "view", str(path_issue), "--json", "body"], capture_output=True, text=True, check=True)
body = json.loads(res.stdout)["body"]

new_line = f"- [ ] {node_title} (#{issue_id})"
if new_line not in body:
    body = body.strip() + "\n" + new_line + "\n"
    update_issue_body(str(path_issue), body)
    print(f"Node {issue_id} successfully linked to Path Meta-Tracker #{path_issue}!")
else:
    print(f"Node {issue_id} is already linked.")
' "$1" "$2" "$PATH_ISSUE"
        ;;
    check)
        if [ "$#" -lt 1 ]; then
            echo "Usage: $0 check <issue_id> [path_issue_id]"
            exit 1
        fi
        PATH_ISSUE="${2:-10}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
import subprocess
import json
import re
from drivers.github_client import update_issue_body

issue_id = sys.argv[1]
path_issue = sys.argv[2]

res = subprocess.run(["gh", "issue", "view", str(path_issue), "--json", "body"], capture_output=True, text=True, check=True)
body = json.loads(res.stdout)["body"]

pattern = rf"- \[ \].*?\(#{issue_id}\).*"
matches = re.findall(pattern, body)

if matches:
    old_line = matches[0]
    new_line = old_line.replace("- [ ]", "- [x]", 1)
    body = body.replace(old_line, new_line, 1)
    update_issue_body(str(path_issue), body)
    print(f"Node {issue_id} successfully marked completed in Path Meta-Tracker #{path_issue}!")
else:
    print(f"Active Node {issue_id} checklist item not found or already checked off.")
' "$1" "$PATH_ISSUE"
        ;;
    active)
        if [ "$#" -lt 4 ]; then
            echo "Usage: $0 active <issue_id> <node_title> <description> <invariants_json> [frontier_file]"
            exit 1
        fi
        FRONTIER_FILE="${5:-artifacts/frontier_state.md}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
import json
from kernel.mgr_frontier import append_active_node

issue_id = int(sys.argv[1])
node_title = sys.argv[2]
description = sys.argv[3]
inv_arg = sys.argv[4]
filepath = sys.argv[5]

if inv_arg.startswith("[") and inv_arg.endswith("]"):
    invariants = json.loads(inv_arg)
else:
    invariants = [inv.strip() for inv in inv_arg.split(",") if inv.strip()]

append_active_node(
    filepath=filepath,
    node_id=issue_id,
    node_title=node_title,
    description=description,
    invariants=invariants
)
print(f"{node_title} set active in local ledger {filepath}!")
' "$1" "$2" "$3" "$4" "$FRONTIER_FILE"
        ;;
    path)
        if [ "$#" -lt 1 ]; then
            echo "Usage: $0 path <path_name_or_none>"
            exit 1
        fi
        FRONTIER_FILE="${2:-artifacts/frontier_state.md}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c "
import sys
from kernel.mgr_frontier import set_active_path

path_name = sys.argv[1]
filepath = sys.argv[2]

set_active_path(filepath, path_name)
print(f'Path {path_name} set active in local ledger {filepath}!')
" "$1" "$FRONTIER_FILE"
        ;;
    audit)
        FRONTIER_FILE="${1:-artifacts/frontier_state.md}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
import re
import json
import os
import subprocess
from drivers import github_client
from drivers.file_locker import lock_file
from kernel import mgr_frontier
from kernel.mgr_backlog import BacklogManager

filepath = sys.argv[1]

# Load taxonomy to find non-terminal types
taxonomy = BacklogManager().load_node_taxonomy()
non_terminals = taxonomy.get("non_terminal", ["path"])

# Load frontier state
state_data = mgr_frontier.load_state(filepath)
nodes = state_data.get("nodes", [])
current_active_path_id = state_data.get("current_active_path")

# Helper to clean titles for matching child nodes to their paths
def clean_title(title: str) -> str:
    cleaned = title
    while True:
        prev = cleaned
        cleaned = re.sub(r"^(?:Node|Activity|Probe|Path)\s*\d+:\s*", "", cleaned, flags=re.IGNORECASE).strip()
        if cleaned == prev:
            break
    cleaned = re.sub(r"^(?:Align|Plan|Reflect)\s*-\s*", "", cleaned, flags=re.IGNORECASE).strip()
    return cleaned

# Helper to extract the node or path ID from name
def extract_node_id(name: str) -> str | None:
    match = re.search(r"\b(?:Node|Activity|Probe|Path)\s*(\d+)\b", name, re.IGNORECASE)
    if match:
        return match.group(1)
    return mgr_frontier.extract_path_id(name)

# Find all completed nodes in the frontier
completed_nodes = []
for n in nodes:
    status = n.get("status", "")
    if status in ("Completed", "Completed (Dry-Run)"):
        name = n.get("name", "")
        node_id = extract_node_id(name)
        if node_id:
            completed_nodes.append({
                "id": str(node_id),
                "name": name,
                "clean_title": clean_title(name)
            })

print(f"Detected {len(completed_nodes)} completed nodes in frontier.")

# Identify all paths in the frontier state
path_nodes = []
path_pattern = re.compile(r"(?:\w+\s+)?Path\s*(\d+):", re.IGNORECASE)

for n in nodes:
    name = n.get("name", "")
    status = n.get("status", "")
    node_id = extract_node_id(name)
    if not node_id:
        continue
    
    is_path = False
    if path_pattern.search(name):
        is_path = True
    else:
        kind = n.get("kind", "").lower()
        if kind in non_terminals:
            is_path = True
            
    if is_path:
        path_nodes.append({
            "id": str(node_id),
            "name": name,
            "clean_title": clean_title(name),
            "status": status
        })

# Target paths to audit
target_paths = {}

# Exclude completed paths from auditing
for p in path_nodes:
    if p["status"] != "Completed":
        target_paths[p["id"]] = p["clean_title"]

# Always ensure the current active path is included
if current_active_path_id:
    current_active_path_id = str(current_active_path_id)
    if current_active_path_id not in target_paths:
        # Resolve active path title from active node name if possible
        active_path_title = None
        active_node_name = state_data.get("current_active_node")
        if active_node_name and active_node_name != "None":
            active_path_title = clean_title(active_node_name)
        target_paths[current_active_path_id] = active_path_title

if not target_paths:
    print("No paths detected in frontier for auditing.")
    sys.exit(0)

# Resolve path title if missing
def get_path_title(path_id: str, local_title: str | None) -> str | None:
    if local_title:
        return local_title
    try:
        res = subprocess.run(["gh", "issue", "view", path_id, "--json", "title"], capture_output=True, text=True, check=True)
        title_data = json.loads(res.stdout)
        return clean_title(title_data.get("title", ""))
    except Exception:
        return None

# Load cached audit state
repo_dir = os.path.dirname(os.path.dirname(os.path.abspath(filepath)))
cache_path = os.path.join(repo_dir, "artifacts", "audit_state.json")

def load_audit_cache():
    if not os.path.exists(cache_path):
        return {}
    with lock_file(cache_path):
        with open(cache_path, "r") as f:
            try:
                return json.load(f)
            except Exception:
                return {}

def save_audit_cache(cache_data):
    os.makedirs(os.path.dirname(cache_path), exist_ok=True)
    with lock_file(cache_path):
        with open(cache_path, "w") as f:
            json.dump(cache_data, f, indent=4)

audit_cache = load_audit_cache()
namespace_data = audit_cache.setdefault("meta-index-audit", {})

for path_id, local_title in sorted(target_paths.items()):
    print(f"Auditing Meta-Index for Path {path_id}...")
    path_title = get_path_title(path_id, local_title)
    
    # Retrieve completed child nodes matching this path title
    path_completed_child_ids = []
    if path_title:
        for cn in completed_nodes:
            cn_title = cn["clean_title"]
            if cn_title.lower() == path_title.lower() or cn_title.lower().endswith(" - " + path_title.lower()):
                path_completed_child_ids.append(cn["id"])
                
    # Load verified nodes for this path from cache
    verified_nodes = namespace_data.get(path_id, [])
    # Compute delta of completed nodes not yet verified
    delta = [nid for nid in path_completed_child_ids if nid not in verified_nodes]
    
    if not delta:
        print(f"  ✓ Path {path_id} audit bypassed (all completed nodes already verified in cache).")
        continue
        
    try:
        res = subprocess.run(["gh", "issue", "view", path_id, "--json", "body"], capture_output=True, text=True, check=True)
        body = json.loads(res.stdout)["body"]
        
        modified = False
        for node_id in path_completed_child_ids:
            node_pattern = rf"- \[ \].*?Node\s+{node_id}:.*"
            matches = re.findall(node_pattern, body, re.IGNORECASE)
            if matches:
                for old_line in matches:
                    new_line = old_line.replace("- [ ]", "- [x]", 1)
                    body = body.replace(old_line, new_line, 1)
                    modified = True
                    print(f"  ✓ Marking Node {node_id} completed in Path {path_id}")
        
        if modified:
            github_client.update_issue_body(path_id, body)
            
        namespace_data[path_id] = sorted(list(set(verified_nodes + path_completed_child_ids)))
        save_audit_cache(audit_cache)
        
    except Exception as e:
        print(f"  ✗ Failed to audit Path {path_id}: {e}")

print("Audit complete.")
' "$FRONTIER_FILE"
        ;;
    rehash)
        FRONTIER_FILE="${1:-artifacts/frontier_state.yml}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
from kernel.mgr_frontier import rehash
rehash(sys.argv[1])
print(f"Successfully rehashed {sys.argv[1]}")
' "$FRONTIER_FILE"
        ;;
    lint)
        FRONTIER_FILE="${1:-artifacts/frontier_state.yml}"
        PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
from kernel.mgr_frontier import load_state, verify_checksum
try:
    verify_checksum(sys.argv[1])
    load_state(sys.argv[1])
    print(f"✓ {sys.argv[1]} is valid and pure.")
except Exception as e:
    print(f"✗ Frontier integrity check failed: {e}")
    sys.exit(1)
' "$FRONTIER_FILE"
        ;;
    *)
        echo "Unknown subcommand: $SUBCOMMAND"
        echo "Usage: $0 {link|check|active|path|audit|rehash|lint} [args...]"
        exit 1
        ;;
esac
