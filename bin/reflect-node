#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 7 ]; then
    echo "Usage: $0 <issue_id> <node_name> <learnings> <invariants> <commit_msg> <branch_name> <pr_title> [frontier_file]"
    echo "  <invariants> can be a comma-separated string or a JSON array."
    exit 1
fi

FRONTIER_FILE="${8:-artifacts/frontier_state.md}"

# Resolve repository root
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve python executable to use
if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python3" ]]; then
    PYTHON_EXE="$VIRTUAL_ENV/bin/python3"
elif [[ -x "/home/pt/actions-runner/venv/bin/python3" ]]; then
    PYTHON_EXE="/home/pt/actions-runner/venv/bin/python3"
else
    PYTHON_EXE="python3"
fi

# Run reflect node operation with parameter parsing
PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c '
import sys
import json
from skills.flow_state_manager import reflect_node

issue_id = sys.argv[1]
node_name = sys.argv[2]
learnings = sys.argv[3]
inv_arg = sys.argv[4]
commit_msg = sys.argv[5]
branch_name = sys.argv[6]
pr_title = sys.argv[7]
frontier_file = sys.argv[8]

if inv_arg.startswith("[") and inv_arg.endswith("]"):
    invariants = json.loads(inv_arg)
else:
    invariants = [inv.strip() for inv in inv_arg.split(",") if inv.strip()]

reflect_node(
    frontier_file=frontier_file,
    issue_id=issue_id,
    node_name=node_name,
    learnings=learnings,
    invariants=invariants,
    commit_msg=commit_msg,
    branch_name=branch_name,
    pr_title=pr_title
)
' "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$FRONTIER_FILE"
