#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $0"
    exit 0
fi

# Resolve repository root
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve python executable to use
if [[ -n "${VIRTUAL_ENV:-}" && -x "$VIRTUAL_ENV/bin/python3" ]]; then
    PYTHON_EXE="$VIRTUAL_ENV/bin/python3"
elif [[ -x "/home/pt/actions-runner/venv/bin/python3" ]]; then
    PYTHON_EXE="/home/pt/actions-runner/venv/bin/python3"
else
    PYTHON_EXE="python3"
fi

# Set execution flag to prevent recursive testing loops
export ANTIGRAVITY_RUNNING_TESTS=1

# Execute unit tests via mandated Python testing harness
PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}" "$PYTHON_EXE" -c "from orchestrator.flow_state_manager import log_stage_advancement; from skills.testing_harness import run_tests; log_stage_advancement('act', 'Executing TDD Test Harness Validation', 'Running pytest on target: tests/'); print(run_tests())"
