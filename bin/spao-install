#!/usr/bin/env bash
# SPAO Installer
# Follows the nvm/pyenv pattern: versioned releases stored in ~/.spao/versions/,
# ~/.spao/current symlink tracks the active version.
#
# Bootstrap (from any machine):
#   curl -sSL https://raw.githubusercontent.com/pltrinh1122/agent-antigravity/main/bin/spao-install | bash
#
# Usage:
#   spao-install                              Fetch latest release, install globally
#   spao-install --version v0.1.0            Fetch & install a specific version
#   spao-install --upgrade                   Fetch latest, update 'current' symlink
#   spao-install --list                      List locally installed versions
#   spao-install --local [DIR]               Set up SPAO in a workspace (default: cwd)
#   spao-install --local [DIR] --version X   Pin workspace to a specific version
#   spao-install --unlink [DIR]              Remove SPAO setup from a workspace
#
# Environment:
#   SPAO_HOME   Override install base (default: ~/.spao)

set -e

# ── Config ────────────────────────────────────────────────────────────────────
SPAO_REPO="pltrinh1122/agent-antigravity"
SPAO_REPO_URL="https://github.com/$SPAO_REPO"
SPAO_HOME="${SPAO_HOME:-$HOME/.spao}"
SPAO_VERSIONS_DIR="$SPAO_HOME/versions"
SPAO_CURRENT="$SPAO_HOME/current"
SPAO_BIN="$HOME/.local/bin/spao"

# ── Helpers ───────────────────────────────────────────────────────────────────
_info()  { echo "  ℹ  $*"; }
_ok()    { echo "  ✅ $*"; }
_warn()  { echo "  ⚠️  $*"; }
_error() { echo "  ❌ $*" >&2; exit 1; }

_require() { command -v "$1" &>/dev/null || _error "'$1' is required but not found in PATH."; }

_latest_version() {
    curl -sSL "https://api.github.com/repos/$SPAO_REPO/releases/latest" \
        | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tag_name',''))" 2>/dev/null
}

_fetch_version() {
    local version="$1"
    local dest="$SPAO_VERSIONS_DIR/$version"

    if [ -d "$dest" ]; then
        _info "Version $version already installed."
        return
    fi

    mkdir -p "$dest"

    local url
    if [ "$version" = "main" ]; then
        url="$SPAO_REPO_URL/archive/refs/heads/main.tar.gz"
    else
        url="$SPAO_REPO_URL/archive/refs/tags/$version.tar.gz"
    fi

    _info "Fetching $url ..."
    curl -sSL "$url" | tar xz -C "$dest" --strip-components=1 \
        || { rm -rf "$dest"; _error "Download failed for $version. Check the tag exists on GitHub."; }
    _ok "Installed SPAO $version → $dest"
}

_set_current() {
    local version="$1"
    local dest="$SPAO_VERSIONS_DIR/$version"
    [ -d "$dest" ] || _error "Version $version not installed."
    ln -sfn "$dest" "$SPAO_CURRENT"
    _ok "Set current → $version"
}

_install_global_shim() {
    mkdir -p "$(dirname "$SPAO_BIN")"

    # Write shim with SPAO_HOME baked in
    cat > "$SPAO_BIN" << SHIM_EOF
#!/usr/bin/env bash
# SPAO Global CLI Shim — auto-generated by spao-install

SPAO_HOME="$SPAO_HOME"

# Resolve workspace root and version
if [ -n "\$SPAO_WORKSPACE_DIR" ]; then
    WORKSPACE_ROOT="\$SPAO_WORKSPACE_DIR"
else
    WORKSPACE_ROOT="\$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

# Resolve core: prefer workspace-pinned version, else current
VERSION_FILE="\$WORKSPACE_ROOT/.spao/version"
if [ -f "\$VERSION_FILE" ]; then
    PINNED="\$(cat "\$VERSION_FILE")"
    SPAO_CORE_DIR="\$SPAO_HOME/versions/\$PINNED"
else
    SPAO_CORE_DIR="\$SPAO_HOME/current"
fi

[ -d "\$SPAO_CORE_DIR" ] || { echo "Error: SPAO core not found. Run: spao-install" >&2; exit 1; }

export SPAO_CORE_DIR
export SPAO_WORKSPACE_DIR="\${SPAO_WORKSPACE_DIR:-\$WORKSPACE_ROOT}"

SUB=\$1; shift
case "\$SUB" in
    node)    PYTHONPATH="\$SPAO_CORE_DIR" python3 "\$SPAO_CORE_DIR/orchestrator/mgr_node.py" "\$@" ;;
    backlog) PYTHONPATH="\$SPAO_CORE_DIR" python3 "\$SPAO_CORE_DIR/orchestrator/mgr_backlog.py" "\$@" ;;
    prompt)  PYTHONPATH="\$SPAO_CORE_DIR" python3 "\$SPAO_CORE_DIR/orchestrator/mgr_prompt.py" "\$@" ;;
    rt)      PYTHONPATH="\$SPAO_CORE_DIR" python3 "\$SPAO_CORE_DIR/orchestrator/mgr_rt.py" "\$@" ;;
    test)    PYTHONPATH="\$SPAO_CORE_DIR" python3 "\$SPAO_CORE_DIR/orchestrator/mgr_testing.py" "\$@" ;;
    version) cat "\$SPAO_HOME/current/VERSION" 2>/dev/null || echo "unknown" ;;
    *)       echo "Usage: spao {node|backlog|prompt|rt|test|version} [options]"; exit 1 ;;
esac
SHIM_EOF

    chmod +x "$SPAO_BIN"
    _ok "Global shim installed: $SPAO_BIN"
}

_update_gemini_rules() {
    local src_gemini="$SPAO_CURRENT/GEMINI.md"
    local global_gemini="$HOME/.gemini/GEMINI.md"
    [ -f "$src_gemini" ] || return
    mkdir -p "$HOME/.gemini"

    local marker="# SPAO Frontier Agent Rules"
    if [ -f "$global_gemini" ] && grep -q "$marker" "$global_gemini"; then
        _info "Updating SPAO rules in ~/.gemini/GEMINI.md..."
        python3 - "$global_gemini" "$src_gemini" << 'PY'
import re, sys
target, src = sys.argv[1], sys.argv[2]
with open(target) as f: c = f.read()
c = re.sub(r'# SPAO Frontier Agent Rules Start.*?# SPAO Frontier Agent Rules End',
           '', c, flags=re.DOTALL).strip()
with open(src) as f: rules = f.read().strip()
with open(target, 'w') as f:
    f.write(c + '\n\n# SPAO Frontier Agent Rules Start\n' + rules + '\n# SPAO Frontier Agent Rules End\n')
PY
    elif [ -f "$global_gemini" ]; then
        _info "Appending SPAO rules to ~/.gemini/GEMINI.md..."
        { printf '\n# SPAO Frontier Agent Rules Start\n'; cat "$src_gemini"; printf '\n# SPAO Frontier Agent Rules End\n'; } >> "$global_gemini"
    else
        _info "Creating ~/.gemini/GEMINI.md with SPAO rules..."
        { printf '# SPAO Frontier Agent Rules Start\n'; cat "$src_gemini"; printf '\n# SPAO Frontier Agent Rules End\n'; } > "$global_gemini"
    fi
    _ok "~/.gemini/GEMINI.md updated"
}

_update_local_gemini() {
    local target_dir="$1"
    local src_gemini="$SPAO_CURRENT/GEMINI.md"
    local local_gemini="$target_dir/GEMINI.md"
    [ -f "$src_gemini" ] || return

    local marker="# SPAO Frontier Agent Rules"
    if [ -f "$local_gemini" ] && grep -q "$marker" "$local_gemini"; then
        _info "Updating SPAO rules in GEMINI.md..."
        python3 - "$local_gemini" "$src_gemini" << 'PY'
import re, sys
target, src = sys.argv[1], sys.argv[2]
with open(target) as f: c = f.read()
c = re.sub(r'# SPAO Frontier Agent Rules Start.*?# SPAO Frontier Agent Rules End',
           '', c, flags=re.DOTALL).strip()
with open(src) as f: rules = f.read().strip()
with open(target, 'w') as f:
    f.write(c + '\n\n# SPAO Frontier Agent Rules Start\n' + rules + '\n# SPAO Frontier Agent Rules End\n')
PY
    elif [ -f "$local_gemini" ]; then
        _info "Appending SPAO rules to GEMINI.md..."
        { printf '\n# SPAO Frontier Agent Rules Start\n'; cat "$src_gemini"; printf '\n# SPAO Frontier Agent Rules End\n'; } >> "$local_gemini"
    else
        _info "Creating GEMINI.md with SPAO rules..."
        { printf '# SPAO Frontier Agent Rules Start\n'; cat "$src_gemini"; printf '\n# SPAO Frontier Agent Rules End\n'; } > "$local_gemini"
    fi
    _ok "GEMINI.md configured"
}

_update_gitignore() {
    local target_dir="$1"
    local gitignore="$target_dir/.gitignore"
    if [ -f "$gitignore" ]; then
        grep -q "^\.spao/$" "$gitignore" || printf '\n# SPAO local installation\n.spao/\n' >> "$gitignore"
    else
        printf '# SPAO local installation\n.spao/\n' > "$gitignore"
    fi
    _ok ".spao/ added to .gitignore"
}

_write_runner() {
    local target_dir="$1"
    local runner="$target_dir/run-spao.sh"

    cat > "$runner" << 'RUNNER_EOF'
#!/usr/bin/env bash
# SPAO Workspace Runner — invokes agy with SPAO environment context.
# Reads .spao/version for pinned release; falls back to ~/.spao/current.
#
# Usage:
#   ./run-spao.sh                        # Interactive agy session in this workspace
#   ./run-spao.sh -p "spao node sync"    # Single non-interactive SPAO prompt
#   ./run-spao.sh --print "..."          # Same, long form
#   ./run-spao.sh --continue / -c        # Resume last agy conversation
#   ./run-spao.sh -i "resume"            # Interactive with initial prompt
#   ./run-spao.sh [agy flags...]         # Any agy flag passthrough

SPAO_WORKSPACE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPAO_DOT_DIR="$SPAO_WORKSPACE_DIR/.spao"
SPAO_HOME="${SPAO_HOME:-$HOME/.spao}"

# Resolve SPAO core: workspace-pinned version takes priority over global 'current'
if [ -f "$SPAO_DOT_DIR/version" ]; then
    PINNED_VERSION="$(cat "$SPAO_DOT_DIR/version")"
    SPAO_CORE_DIR="$SPAO_HOME/versions/$PINNED_VERSION"
else
    SPAO_CORE_DIR="$SPAO_HOME/current"
fi

if [ ! -d "$SPAO_CORE_DIR" ]; then
    echo "Error: SPAO core not found at $SPAO_CORE_DIR" >&2
    echo "Run: spao-install   (or: spao-install --version <tag>)" >&2
    exit 1
fi

export SPAO_CORE_DIR
export SPAO_WORKSPACE_DIR

command -v agy &>/dev/null || { echo "Error: 'agy' not found in PATH." >&2; exit 1; }

cd "$SPAO_WORKSPACE_DIR"

if [ $# -eq 0 ]; then
    PINNED_VER="$(cat "$SPAO_DOT_DIR/version" 2>/dev/null || basename "$SPAO_CORE_DIR")"
    printf '\n'
    printf '\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\n'
    printf '\u2551  SPAO Workspace Runner  (%s)\n' "$PINNED_VER"
    printf '\u2551  Core:      %s\n' "$SPAO_CORE_DIR"
    printf '\u2551  Workspace: %s\n' "$SPAO_WORKSPACE_DIR"
    printf '\u2560\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2563\n'
    printf '\u2551  Usage:\n'
    printf '\u2551    ./run-spao.sh                    Interactive session\n'
    printf '\u2551    ./run-spao.sh -p "spao node sync"  Single prompt\n'
    printf '\u2551    ./run-spao.sh --continue / -c    Resume conversation\n'
    printf '\u2551    ./run-spao.sh -i "resume"        Interactive + prompt\n'
    printf '\u2551  See README.spao.md for full documentation.\n'
    printf '\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\n'
    printf '\n'
    exec agy --add-dir "$SPAO_CORE_DIR"
else
    exec agy --add-dir "$SPAO_CORE_DIR" "$@"
fi
RUNNER_EOF

    chmod +x "$runner"
    _ok "Created run-spao.sh"
}

_write_readme() {
    local target_dir="$1"
    local readme="$target_dir/README.spao.md"

    if [ -f "$readme" ]; then
        _warn "README.spao.md already exists — skipping (edit manually to update)"
        return
    fi

    cat > "$readme" << 'README_EOF'
# SPAO — Sense-Plan-Act-Observe System

This project is managed by the **SPAO Frontier Agent** via
[Antigravity CLI (`agy`)](https://github.com/pltrinh1122/agent-antigravity).

## Quick Start

Launch an agy session with full SPAO context:

    ./run-spao.sh

Run a single SPAO command non-interactively:

    ./run-spao.sh -p "spao node sync"

Resume your last conversation:

    ./run-spao.sh --continue

## Bootstrap

    curl -sSL https://raw.githubusercontent.com/pltrinh1122/agent-antigravity/main/bin/spao-install | bash -s -- --local

## Version Management

| File | Purpose |
|---|---|
| `.spao/version` | Pinned SPAO core version for this workspace |
| `GEMINI.md` | SPAO invariants injected into agy context |
| `run-spao.sh` | agy launcher with SPAO env wired in |

Upgrade:

    spao-install --upgrade
    spao-install --local

## How it works

`run-spao.sh` sets `SPAO_CORE_DIR` and `SPAO_WORKSPACE_DIR` before invoking
`agy --add-dir`, making the SPAO orchestration scripts available as context.
README_EOF

    _ok "Created README.spao.md"
}

usage() {
    cat << 'USAGE'
SPAO Installer — distributes the SPAO Frontier Agent system

Usage:
  spao-install                              Fetch latest release, install globally
  spao-install --version <tag>             Fetch & install a specific version
  spao-install --upgrade                   Fetch latest release, update 'current'
  spao-install --list                      List locally installed versions
  spao-install --local [DIR]               Set up SPAO in a workspace (default: cwd)
  spao-install --local [DIR] --version X   Pin workspace to a specific version
  spao-install --unlink [DIR]              Remove SPAO setup from a workspace

Environment:
  SPAO_HOME   Override install base directory (default: ~/.spao)

Bootstrap (from any machine, no prior install needed):
  curl -sSL https://raw.githubusercontent.com/pltrinh1122/agent-antigravity/main/bin/spao-install | bash
USAGE
    exit 0
}

# ── Argument parsing ──────────────────────────────────────────────────────────
MODE=""
TARGET_DIR=""
VERSION=""

while [ $# -gt 0 ]; do
    case "$1" in
        --local)   MODE="local";  TARGET_DIR="${2:-}"; [ -n "${2:-}" ] && shift ;;
        --unlink)  MODE="unlink"; TARGET_DIR="${2:-}"; [ -n "${2:-}" ] && shift ;;
        --upgrade) MODE="upgrade" ;;
        --list)    MODE="list" ;;
        --version) VERSION="$2"; shift ;;
        --help|-h) usage ;;
        *)         _error "Unknown argument: $1. Run with --help for usage." ;;
    esac
    shift
done

[ -z "$MODE" ] && MODE="global"
_require curl
_require python3
mkdir -p "$SPAO_VERSIONS_DIR"

# ── Mode: list ────────────────────────────────────────────────────────────────
if [ "$MODE" = "list" ]; then
    echo "Installed SPAO versions (${SPAO_VERSIONS_DIR}):"
    if [ -d "$SPAO_VERSIONS_DIR" ] && [ -n "$(ls -A "$SPAO_VERSIONS_DIR" 2>/dev/null)" ]; then
        current_dest="$(readlink "$SPAO_CURRENT" 2>/dev/null || true)"
        for v in "$SPAO_VERSIONS_DIR"/*/; do
            vname="$(basename "$v")"
            if [ "$SPAO_VERSIONS_DIR/$vname" = "$current_dest" ]; then
                echo "  * $vname  (current)"
            else
                echo "    $vname"
            fi
        done
    else
        echo "  (none — run: spao-install)"
    fi
    exit 0
fi

# ── Mode: unlink ──────────────────────────────────────────────────────────────
if [ "$MODE" = "unlink" ]; then
    TARGET_DIR="${TARGET_DIR:-$(pwd)}"
    TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
    echo "Removing SPAO workspace setup from: $TARGET_DIR"
    [ -d "$TARGET_DIR/.spao" ]     && rm -rf "$TARGET_DIR/.spao"     && _ok "Removed .spao/"
    [ -f "$TARGET_DIR/run-spao.sh" ] && rm "$TARGET_DIR/run-spao.sh" && _ok "Removed run-spao.sh"
    echo "✅ Done. GEMINI.md preserved (edit manually if needed)."
    exit 0
fi

# ── Mode: global / upgrade ────────────────────────────────────────────────────
if [ "$MODE" = "global" ] || [ "$MODE" = "upgrade" ]; then
    if [ -z "$VERSION" ]; then
        _info "Resolving latest release from GitHub..."
        VERSION="$(_latest_version)"
        [ -n "$VERSION" ] || _error "Could not determine latest version. Specify with --version <tag>."
        _info "Latest: $VERSION"
    fi

    _fetch_version "$VERSION"
    _set_current "$VERSION"
    _install_global_shim
    _update_gemini_rules

    echo ""
    echo "✅ SPAO $VERSION installed."
    echo "   Global shim:  $SPAO_BIN"
    echo "   Core:         $SPAO_HOME/current  →  $SPAO_VERSIONS_DIR/$VERSION"
    echo ""
    echo "   Bootstrap any project in one command:"
    echo "   curl -sSL https://raw.githubusercontent.com/pltrinh1122/agent-antigravity/main/bin/spao-install | bash -s -- --local"
    echo ""
    echo "   Next: run 'spao-install --local' inside any project to set it up."
    exit 0
fi

# ── Mode: local ───────────────────────────────────────────────────────────────
if [ "$MODE" = "local" ]; then
    TARGET_DIR="${TARGET_DIR:-$(pwd)}"
    mkdir -p "$TARGET_DIR"
    TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"
    echo "Setting up SPAO workspace: $TARGET_DIR"

    # Auto-bootstrap global install if current doesn't exist yet
    if [ ! -e "$SPAO_CURRENT" ]; then
        _info "No global SPAO install found — bootstrapping now..."
        if [ -z "$VERSION" ]; then
            VERSION="$(_latest_version)"
            [ -n "$VERSION" ] || _error "Could not determine latest version. Specify with --version <tag>."
        fi
        _fetch_version "$VERSION"
        _set_current "$VERSION"
        _install_global_shim
        _update_gemini_rules
    elif [ -n "$VERSION" ]; then
        # Version-pin: fetch the requested version but don't change global 'current'
        _fetch_version "$VERSION"
    fi

    # Determine pinned version for this workspace
    if [ -n "$VERSION" ]; then
        RESOLVED_VERSION="$VERSION"
    else
        RESOLVED_VERSION="$(basename "$(readlink "$SPAO_CURRENT")")"
    fi

    # Create .spao/ with version pin
    SPAO_DOT_DIR="$TARGET_DIR/.spao"
    mkdir -p "$SPAO_DOT_DIR"
    echo "$RESOLVED_VERSION" > "$SPAO_DOT_DIR/version"
    _ok "Created .spao/version  ($RESOLVED_VERSION)"

    _update_gitignore "$TARGET_DIR"
    _write_runner "$TARGET_DIR"
    _update_local_gemini "$TARGET_DIR"
    _write_readme "$TARGET_DIR"

    echo ""
    echo "✅ SPAO workspace ready: $TARGET_DIR"
    echo "   Pinned to:       $RESOLVED_VERSION"
    echo "   Launch:          ./run-spao.sh"
    echo "   Documentation:   ./README.spao.md"
    echo "   Upgrade:         spao-install --upgrade  then re-run --local to re-pin"
    echo ""
    echo "   One-step bootstrap (share with teammates):"
    echo "   curl -sSL https://raw.githubusercontent.com/pltrinh1122/agent-antigravity/main/bin/spao-install | bash -s -- --local"
    exit 0
fi
