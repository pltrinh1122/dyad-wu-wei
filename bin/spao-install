#!/usr/bin/env bash
set -e

# Resolve absolute path to the directory containing this script, then its parent (repo root)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPAO_CORE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Directories from the SPAO core that must be accessible in the target workspace
# so that both `spao <sub>` AND `./bin/<sub>` invocation forms work per GEMINI.md invariants.
LINK_TARGETS=("bin" "skills" "orchestrator")

usage() {
    echo "Usage:"
    echo "  spao-install                     # Install global 'spao' CLI to ~/.local/bin"
    echo "  spao-install --local [DIR]       # Set up SPAO in a local workspace (default: cwd)"
    echo "  spao-install --unlink [DIR]      # Remove SPAO symlinks from a local workspace"
    exit 1
}

# ──────────────────────────────────────────────────────────────────────────────
# LOCAL INSTALL MODE
# ──────────────────────────────────────────────────────────────────────────────
if [ "$1" = "--local" ]; then
    TARGET_DIR="${2:-$(pwd)}"
    TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

    echo "Installing SPAO locally to workspace: $TARGET_DIR"
    echo "Core codebase: $SPAO_CORE_DIR"

    # 1. Symlink bin/, skills/, orchestrator/ from core into the workspace
    #    so `./bin/node sync`, `./bin/prompt list`, etc. all resolve correctly.
    for dir in "${LINK_TARGETS[@]}"; do
        LINK_PATH="$TARGET_DIR/$dir"
        LINK_TARGET="$SPAO_CORE_DIR/$dir"
        if [ -L "$LINK_PATH" ]; then
            echo "  ↻ Updating symlink: $dir/ → $LINK_TARGET"
            ln -sfn "$LINK_TARGET" "$LINK_PATH"
        elif [ -e "$LINK_PATH" ]; then
            echo "  ⚠️  $dir/ already exists as a real directory — skipping symlink (manual review needed)"
        else
            echo "  ✅ Linking: $dir/ → $LINK_TARGET"
            ln -s "$LINK_TARGET" "$LINK_PATH"
        fi
    done

    # 2. Generate run-spao.sh — agy launcher that sources SPAO env context
    TARGET_RUNNER="$TARGET_DIR/run-spao.sh"

    cat << 'RUNNER_EOF' > "$TARGET_RUNNER"
#!/usr/bin/env bash
# Local SPAO Workspace Runner
# Invokes agy (Antigravity CLI) with SPAO environment context pre-configured.
# The workspace GEMINI.md provides agy with the full SPAO meta-orchestrator instructions.
# bin/, skills/, orchestrator/ are symlinked from the SPAO core repo so that
# both `spao <sub>` and `./bin/<sub>` invocation forms work per GEMINI.md invariants.
#
# Usage:
#   ./run-spao.sh                          # Launch agy interactively in this workspace
#   ./run-spao.sh -p "spao node sync"      # Run a single SPAO prompt non-interactively
#   ./run-spao.sh --print "spao prompt list"
#   ./run-spao.sh --continue               # Resume the most recent agy conversation
#   ./run-spao.sh -c                       # Short alias for --continue
#   ./run-spao.sh -i "resume"              # Start with an initial prompt interactively
#   ./run-spao.sh [any agy flags...]       # Pass any other agy flags through directly

# Resolve workspace root as the directory containing this script
SPAO_WORKSPACE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Core SPAO Codebase Path (baked in at install time)
SPAO_CORE_DIR="REPLACE_SPAO_CORE_DIR"

export SPAO_CORE_DIR
export SPAO_WORKSPACE_DIR

# Ensure agy is available
if ! command -v agy &>/dev/null; then
    echo "Error: 'agy' (Antigravity CLI) is not installed or not in PATH." >&2
    exit 1
fi

# cd into workspace so agy picks up the local GEMINI.md
cd "$SPAO_WORKSPACE_DIR"

if [ $# -eq 0 ]; then
    # No args: launch agy interactively; workspace GEMINI.md supplies SPAO context
    exec agy --add-dir "$SPAO_CORE_DIR"
else
    # Pass all flags/args through to agy unchanged
    exec agy --add-dir "$SPAO_CORE_DIR" "$@"
fi
RUNNER_EOF

    # Substitute REPLACE_SPAO_CORE_DIR with the actual baked-in path
    python3 -c "
with open('$TARGET_RUNNER', 'r') as f:
    content = f.read()
content = content.replace('REPLACE_SPAO_CORE_DIR', '$SPAO_CORE_DIR')
with open('$TARGET_RUNNER', 'w') as f:
    f.write(content)
"
    chmod +x "$TARGET_RUNNER"
    echo "  ✅ Created runner: $TARGET_RUNNER"

    # 3. Create / update local GEMINI.md with SPAO rules block
    LOCAL_GEMINI="$TARGET_DIR/GEMINI.md"
    SPAO_RULES_MARKER="# SPAO Meta-Orchestrator Rules"

    if [ -f "$LOCAL_GEMINI" ]; then
        if grep -q "$SPAO_RULES_MARKER" "$LOCAL_GEMINI"; then
            echo "  ↻ Updating SPAO rules block in local GEMINI.md..."
            python3 -c "
import re
with open('$LOCAL_GEMINI', 'r') as f:
    content = f.read()
content = re.sub(r'# SPAO Meta-Orchestrator Rules Start.*?# SPAO Meta-Orchestrator Rules End', '', content, flags=re.DOTALL).strip()
with open('$SPAO_CORE_DIR/GEMINI.md', 'r') as f:
    spao_rules = f.read().strip()
new_content = content + '\n\n# SPAO Meta-Orchestrator Rules Start\n' + spao_rules + '\n# SPAO Meta-Orchestrator Rules End\n'
with open('$LOCAL_GEMINI', 'w') as f:
    f.write(new_content.strip() + '\n')
"
        else
            echo "  ✅ Appending SPAO rules to existing local GEMINI.md..."
            printf '\n# SPAO Meta-Orchestrator Rules Start\n' >> "$LOCAL_GEMINI"
            cat "$SPAO_CORE_DIR/GEMINI.md" >> "$LOCAL_GEMINI"
            printf '\n# SPAO Meta-Orchestrator Rules End\n' >> "$LOCAL_GEMINI"
        fi
    else
        echo "  ✅ Creating local GEMINI.md with SPAO rules..."
        printf '# SPAO Meta-Orchestrator Rules Start\n' > "$LOCAL_GEMINI"
        cat "$SPAO_CORE_DIR/GEMINI.md" >> "$LOCAL_GEMINI"
        printf '\n# SPAO Meta-Orchestrator Rules End\n' >> "$LOCAL_GEMINI"
    fi

    echo ""
    echo "✅ SPAO workspace ready at: $TARGET_DIR"
    echo "   Run './run-spao.sh' to launch agy with SPAO context."

# ──────────────────────────────────────────────────────────────────────────────
# UNLINK MODE
# ──────────────────────────────────────────────────────────────────────────────
elif [ "$1" = "--unlink" ]; then
    TARGET_DIR="${2:-$(pwd)}"
    TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

    echo "Removing SPAO symlinks from workspace: $TARGET_DIR"

    for dir in "${LINK_TARGETS[@]}"; do
        LINK_PATH="$TARGET_DIR/$dir"
        if [ -L "$LINK_PATH" ]; then
            rm "$LINK_PATH"
            echo "  ✅ Removed symlink: $dir/"
        else
            echo "  — Not a symlink (skipping): $dir/"
        fi
    done

    [ -f "$TARGET_DIR/run-spao.sh" ] && rm "$TARGET_DIR/run-spao.sh" && echo "  ✅ Removed run-spao.sh"
    echo "✅ Unlinked. GEMINI.md preserved (edit manually if needed)."

# ──────────────────────────────────────────────────────────────────────────────
# GLOBAL INSTALL MODE (default)
# ──────────────────────────────────────────────────────────────────────────────
elif [ -z "$1" ]; then
    INSTALL_DIR="$HOME/.local/bin"
    mkdir -p "$INSTALL_DIR"
    TARGET_BIN="$INSTALL_DIR/spao"

    echo "Installing global SPAO CLI..."
    echo "Core codebase path: $SPAO_CORE_DIR"
    echo "Target binary path: $TARGET_BIN"

    cat << 'EOF' > "$TARGET_BIN"
#!/usr/bin/env bash
# Global SPAO CLI Entrypoint Wrapper

# Core SPAO Codebase Path
SPAO_CORE_DIR="REPLACE_SPAO_CORE_DIR"

# Resolve Active Project Workspace Root
if [ -n "$SPAO_WORKSPACE_DIR" ]; then
    WORKSPACE_ROOT="$SPAO_WORKSPACE_DIR"
else
    WORKSPACE_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -z "$WORKSPACE_ROOT" ]; then
        WORKSPACE_ROOT="$(pwd)"
    fi
fi

export SPAO_CORE_DIR
export SPAO_WORKSPACE_DIR="$WORKSPACE_ROOT"

SUB=$1
shift

case "$SUB" in
    node)
        PYTHONPATH="$SPAO_CORE_DIR" python3 "$SPAO_CORE_DIR/orchestrator/mgr_node.py" "$@"
        ;;
    backlog)
        PYTHONPATH="$SPAO_CORE_DIR" python3 "$SPAO_CORE_DIR/orchestrator/mgr_backlog.py" "$@"
        ;;
    prompt)
        PYTHONPATH="$SPAO_CORE_DIR" python3 "$SPAO_CORE_DIR/orchestrator/mgr_prompt.py" "$@"
        ;;
    rt)
        PYTHONPATH="$SPAO_CORE_DIR" python3 "$SPAO_CORE_DIR/orchestrator/mgr_rt.py" "$@"
        ;;
    test)
        PYTHONPATH="$SPAO_CORE_DIR" python3 "$SPAO_CORE_DIR/orchestrator/mgr_testing.py" "$@"
        ;;
    *)
        echo "Usage: spao {node|backlog|prompt|rt|test} [options]"
        exit 1
        ;;
esac
EOF

    python3 -c "
with open('$TARGET_BIN', 'r') as f:
    content = f.read()
content = content.replace('REPLACE_SPAO_CORE_DIR', '$SPAO_CORE_DIR')
with open('$TARGET_BIN', 'w') as f:
    f.write(content)
"
    chmod +x "$TARGET_BIN"

    # Update global GEMINI.md
    GLOBAL_GEMINI="$HOME/.gemini/GEMINI.md"
    mkdir -p "$HOME/.gemini"
    SPAO_RULES_MARKER="# SPAO Meta-Orchestrator Rules"

    if [ -f "$GLOBAL_GEMINI" ]; then
        if grep -q "$SPAO_RULES_MARKER" "$GLOBAL_GEMINI"; then
            echo "Global GEMINI.md already contains SPAO rules. Updating in-place..."
            python3 -c "
import re
with open('$GLOBAL_GEMINI', 'r') as f:
    content = f.read()
content = re.sub(r'# SPAO Meta-Orchestrator Rules Start.*?# SPAO Meta-Orchestrator Rules End', '', content, flags=re.DOTALL).strip()
with open('$SPAO_CORE_DIR/GEMINI.md', 'r') as f:
    spao_rules = f.read().strip()
new_content = content + '\n\n# SPAO Meta-Orchestrator Rules Start\n' + spao_rules + '\n# SPAO Meta-Orchestrator Rules End\n'
with open('$GLOBAL_GEMINI', 'w') as f:
    f.write(new_content.strip() + '\n')
"
        else
            echo "Appending SPAO rules to global GEMINI.md..."
            printf '\n# SPAO Meta-Orchestrator Rules Start\n' >> "$GLOBAL_GEMINI"
            cat "$SPAO_CORE_DIR/GEMINI.md" >> "$GLOBAL_GEMINI"
            printf '\n# SPAO Meta-Orchestrator Rules End\n' >> "$GLOBAL_GEMINI"
        fi
    else
        echo "Creating global GEMINI.md with SPAO rules..."
        printf '# SPAO Meta-Orchestrator Rules Start\n' > "$GLOBAL_GEMINI"
        cat "$SPAO_CORE_DIR/GEMINI.md" >> "$GLOBAL_GEMINI"
        printf '\n# SPAO Meta-Orchestrator Rules End\n' >> "$GLOBAL_GEMINI"
    fi

    echo "✅ Successfully installed 'spao' globally to $TARGET_BIN"
    echo "Ensure $INSTALL_DIR is in your shell PATH."

else
    usage
fi
