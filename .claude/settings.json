{
  "permissions": {
    "allow": [
      "Bash(bin/git:*)",
      "Bash(bin/gh:*)",
      "Bash(bin/standup.sh)",
      "Bash(./bin/standup.sh)",
      "Bash(bin/standdown.sh)",
      "Bash(./bin/standdown.sh)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)"
    ]
  }
}
